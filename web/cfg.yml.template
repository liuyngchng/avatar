# Avatar Web 配置文件模板
# 复制此文件为 cfg.yml 并填入实际值

# LLM 对话
llm:
  base_url: "https://api.deepseek.com"
  api_key: ""
  model: "deepseek-v4-flash"

# 唤醒词（sherpa-onnx 关键词格式: "音素序列 @中文显示名"）
# 默认: "x iǎo h uǒ x iǎo h uǒ @小火小火"
wake_word: "x iǎo h uǒ x iǎo h uǒ @小火小火"

# ASR 语音识别: "offline" 使用本地 sherpa-onnx, "online" 使用阿里云百炼 DashScope
asr:
  mode: "offline"
  # 在线 ASR 配置（仅 mode=online 时需要）
  url: "wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference"
  model: "qwen-audio-3.0-asr-flash-streaming"
  format: "pcm"
  sample_rate: 16000

# TTS 语音合成: "offline" 使用本地 Matcha-TTS, "online" 使用阿里云百炼 DashScope
tts:
  mode: "offline"
  # 在线 TTS 配置（仅 mode=online 时需要）
  url: "wss://dashscope.aliyuncs.com/api-ws/v1/realtime"
  model: "qwen3-tts-flash-realtime"
  voice: "Cherry"
  format: "pcm"
  sample_rate: 24000

# 百炼 API Key（mode=online 时必填，llm/aliyun 共用）
api_key: ""

# 代理设置（可选，优先级高于环境变量 HTTPS_PROXY/HTTP_PROXY）
proxy: ""

# 强制关闭代理（可选）。设为 true 时，无论 cfg.yml 的 proxy 字段还是
# 环境变量代理，一律直连，不做任何代理。
# proxy_disabled: true

# HTTP 服务器
server:
  port: 8080
  static_dir: "web"
  # TLS 证书（可选）: 如果 cert.pem/key.pem 存在则自动启用 HTTPS
  # 用 ./avatar-server -gen-cert 生成自签名证书
  # cert_file: "cert.pem"
  # key_file: "key.pem"